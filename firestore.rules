rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function: verifies user is authenticated via Firebase Auth
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != '';
    }

    // Helper function: checks if user has cryptographic admin custom claim
    // SEC-02 HARDENING: Role derives exclusively from server-signed JWT Custom Claim
    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    // Helper function: verifies ownership of document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Products collection:
    // Anyone can read products.
    // SEC-03 HARDENING: Only verified administrators and backend services can write.
    // Clients CANNOT directly mutate products, prices, stock, reviews or ratings.
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();

      // Subcollection for dedicated reviews
      match /reviews/{reviewId} {
        allow read: if true;
        // Reviews must be created through backend API /api/reviews which verifies completed purchases
        allow create, update, delete: if isAdmin();
      }
    }

    // Users collection:
    // Each user can read their own profile; admins can read all profiles.
    // SEC-01 HARDENING: Prevent self-promotion. Role field is strictly locked.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && 
        (!('role' in request.resource.data) || request.resource.data.role == 'customer') &&
        request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'createdAt', 'updatedAt']);
      allow update: if (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'admin'])) || isAdmin();
      allow delete: if isAdmin();
    }

    // Orders collection:
    // P0.1 HARDENING: Orders CANNOT be created directly via client-side SDK!
    // Orders must be issued through the authoritative server endpoint /api/orders.
    match /orders/{orderId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if false; // Prohibit direct client-side creation!
      
      // P1.6 HARDENING: Status transitions strictly limited to admin and only status/updatedAt fields
      allow update: if isAdmin() && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']) &&
        request.resource.data.status in ['pending', 'processing', 'completed', 'cancelled'];
      allow delete: if isAdmin();
    }
  }
}
