rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function: verifies user is authenticated via Firebase Auth
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != '';
    }

    // Helper function: checks if user has cryptographic admin custom claim
    // SEC-02 HARDENING: Role derives exclusively from server-signed JWT Custom Claim
    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    // Helper function: verifies ownership of document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Products collection:
    // Anyone (even unauthenticated visitors) can read products.
    // Only verified administrators with Custom Claim can create, update catalog fields, or delete.
    // Authenticated users can only submit reviews and update aggregate ratings.
    match /products/{productId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isAuthenticated() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reviews', 'rating', 'ratingCount'])
      );

      // Subcollection: Product reviews
      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isAuthenticated() && 
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.rating is number &&
          request.resource.data.rating >= 1 &&
          request.resource.data.rating <= 5 &&
          request.resource.data.comment is string &&
          request.resource.data.comment.size() >= 3 &&
          request.resource.data.comment.size() <= 1000 &&
          request.resource.data.keys().hasOnly(['id', 'productId', 'userId', 'userName', 'rating', 'comment', 'createdAt', 'isVerifiedBuyer']);
        allow update, delete: if isAdmin() || isOwner(resource.data.userId);
      }
    }

    // Users collection:
    // Each user can read their own profile; admins can read all profiles.
    // SEC-01 HARDENING: Prevent self-promotion. Role field is strictly locked.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && 
        (!('role' in request.resource.data) || request.resource.data.role == 'customer') &&
        request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'createdAt', 'updatedAt']);
      allow update: if (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'admin'])) || isAdmin();
      allow delete: if isAdmin();
    }

    // Orders collection:
    // SEC-03 HARDENING: Orders strictly validated. Customers cannot fabricate arbitrary totals or statuses.
    match /orders/{orderId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && 
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.items is list &&
        request.resource.data.items.size() > 0 &&
        request.resource.data.totalPrice is number &&
        request.resource.data.totalPrice > 0 &&
        request.resource.data.totalQuantity is int &&
        request.resource.data.totalQuantity > 0 &&
        request.resource.data.shippingAddress is map &&
        request.resource.data.createdAt is string &&
        request.resource.data.keys().hasOnly(['userId', 'userEmail', 'items', 'totalPrice', 'totalQuantity', 'status', 'shippingAddress', 'createdAt']);
      allow update: if isAdmin(); // Only admins can transition order statuses
      allow delete: if isAdmin();
    }
  }
}
